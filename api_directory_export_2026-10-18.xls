     target="_blank" 
     rel="noopener noreferrer" 
     class="styled-link"&gt;
    here for more information&lt;/a&gt;&lt;/b&gt;.&lt;/p&gt;


&lt;style&gt;
.styled-link {
  color: blue;               /* hyperlink blue */
  text-decoration: underline; /* underline like a normal link */
  cursor: pointer;           /* hand cursor on hover */
